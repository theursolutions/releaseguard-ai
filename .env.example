# Copy to .env (never commit .env), then fill in every value.

# Laravel encryption key for the portal. It also encrypts the saved connection secrets, so keep it safe
# and never change it after connections are saved.
# Generate: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

APP_URL=http://localhost:8080
# Change if port 8080 is already used on your machine (keep APP_URL in sync).
PORTAL_PORT=8080

# One random token per service; the portal sends it, the service checks it.
# Generate each: docker run --rm php:8.3-cli php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
PRD_SERVICE_TOKEN=
MONITORING_SERVICE_TOKEN=

# Assistant service token (generate like the others)
ASSISTANT_SERVICE_TOKEN=

# Performance service token (generate like the others)
PERFORMANCE_SERVICE_TOKEN=

# Optional: git URL of the AI Dev Toolkit repository. When set, the Toolkit page also shows "git clone" steps.
TOOLKIT_REPO_URL=
